<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Title>A library to handle XML files</Title>
    <Description>Handle and compare xml file easily</Description>
    <PackageProjectUrl>https://github.com/VasilisPlavos/BrainSharp.Xml</PackageProjectUrl>
    <RepositoryUrl>https://github.com/VasilisPlavos/BrainSharp.Xml</RepositoryUrl>
    <PackageTags>xml xmldiff xmlpatch compare-xml xml-differences</PackageTags>
    <PackageReleaseNotes>Fix child matching (#1), faster comparison, true async file parsing, Xml constructor obsolete (static class in 2.0.0), correct repository URL.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>BrainSharp.Xml</PackageId>
    <Version>1.1.0</Version>
    <Authors>Vasilis Plavos</Authors>
    <Company>BrainSharp</Company>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>



  <ItemGroup>
    <PackageReference Include="BrainSharp.XmlDiff" Version="1.0.1" />
  </ItemGroup>

</Project>
